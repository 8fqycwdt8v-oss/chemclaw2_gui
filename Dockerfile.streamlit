FROM python:3.12-slim AS base

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    UV_LINK_MODE=copy

COPY --from=ghcr.io/astral-sh/uv:0.9 /uv /usr/local/bin/uv

WORKDIR /app

# Resolve and install deps first (cached layer)
COPY pyproject.toml uv.lock* ./
RUN uv sync --frozen --no-dev --no-install-project

# Put the venv on PATH so we don't pay the `uv run` startup cost per command
ENV PATH="/app/.venv/bin:${PATH}"

# Then copy source
COPY app/ ./app/
COPY .streamlit/ ./.streamlit/

RUN useradd --create-home --uid 1001 streamlit && chown -R streamlit:streamlit /app
USER streamlit

EXPOSE 8501

# Healthcheck uses Streamlit's built-in `/_stcore/health` endpoint (verified
# in streamlit/web/server/starlette/starlette_routes.py — returns "ok",
# no auth, no cookies). Implemented via Python stdlib to avoid pulling
# curl/wget into the slim image. Fly's [[http_service.checks]] in fly.toml
# is the primary probe in production; this is belt-and-braces for non-Fly
# deploys.
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8501/_stcore/health', timeout=4).read()" || exit 1

CMD ["streamlit", "run", "app/main.py", \
     "--server.address", "0.0.0.0", "--server.port", "8501"]
