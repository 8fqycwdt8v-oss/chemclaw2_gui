# chemclaw2 backend (Python FastAPI; default uvicorn port is 8080)
CHEMCLAW2_API_URL=http://host.docker.internal:8080

# Optional. When set, Streamlit signs HMAC service tokens
# (Authorization: Bearer svc.<sub>.<iat>.<sig>) which require chemclaw2
# to implement the corresponding verifier (a BACKLOG item with a maxAge
# constraint). When empty, Streamlit sends `Bearer mock:<sub>`, which
# chemclaw2 accepts in dev mode (CLERK_SECRET_KEY unset/sk_test_REPLACE*).
CHEMCLAW2_SERVICE_SECRET=

# Optional. Identity provider key in .streamlit/secrets.toml's [auth.<name>] block.
STREAMLIT_LOGIN_PROVIDER=microsoft
