# Identity provider (Microsoft Entra ID)
# Tenant ID from Entra → App registrations → Overview
CHEMCLAW2_IDP_DOMAIN=login.microsoftonline.com/<tenant-id>/v2.0
CHEMCLAW2_IDP_AUDIENCE=api://chemclaw2-gui

# chemclaw2 backend
CHEMCLAW2_API_URL=http://host.docker.internal:3000
# HMAC shared with chemclaw2 backend (BACKLOG item #1). Empty disables service-token auth
# (then BFF passes the user id_token through as Bearer — works only if chemclaw2 trusts the IdP).
CHEMCLAW2_SERVICE_SECRET=

# Streamlit → BFF
STREAMLIT_BFF_URL=http://bff:8000
