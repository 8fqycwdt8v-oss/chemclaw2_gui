# Identity provider (Microsoft Entra ID)
# Tenant ID from Entra → App registrations → Overview
CHEMCLAW2_IDP_DOMAIN=login.microsoftonline.com/<tenant-id>/v2.0
CHEMCLAW2_IDP_AUDIENCE=api://chemclaw2-gui

# chemclaw2 backend (Python FastAPI; default uvicorn port is 8080)
CHEMCLAW2_API_URL=http://host.docker.internal:8080
# HMAC shared with chemclaw2 (see README → "BACKLOG items in chemclaw2" → #1).
# When empty, BFF sends `Bearer mock:<sub>` which chemclaw2 accepts in dev mode
# (CLERK_SECRET_KEY unset or starts with sk_test_REPLACE). Production must
# either implement the HMAC verifier in chemclaw2 and set this, or migrate to
# shared OIDC.
CHEMCLAW2_SERVICE_SECRET=

# Streamlit → BFF
STREAMLIT_BFF_URL=http://bff:8000
