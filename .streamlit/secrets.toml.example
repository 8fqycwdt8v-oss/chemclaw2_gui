# Copy to .streamlit/secrets.toml (gitignored) and fill in real values.
# Reference: https://docs.streamlit.io/develop/api-reference/user/st.login

[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
cookie_secret = "REPLACE_WITH_RANDOM_32_BYTES"
# expose_tokens belongs in the shared [auth] section, NOT under a named provider.
# It applies to ALL providers; the same tokens are exposed for each.
expose_tokens = "id"

# Microsoft Entra ID (default)
# From Entra portal → App registrations → your app:
#   tenant_id is in Overview; client_id is "Application (client) ID";
#   client_secret is created under Certificates & secrets.
[auth.microsoft]
client_id = ""
client_secret = ""
server_metadata_url = "https://login.microsoftonline.com/<tenant-id>/v2.0/.well-known/openid-configuration"
client_kwargs = { scope = "openid email profile offline_access" }

# Optional alternative: Auth0 (uncomment + fill if you prefer Auth0 over Entra)
# [auth.auth0]
# client_id = ""
# client_secret = ""
# server_metadata_url = "https://<tenant>.auth0.com/.well-known/openid-configuration"
# client_kwargs = { scope = "openid email profile" }
